ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Backblaze B2 (S3-compatible). Leave blank to skip re-hosting (dev only).
# Create a bucket at https://www.backblaze.com/ (Public bucket for the generated
# landing pages to load images without signed URLs), then create an Application
# Key scoped to that bucket.
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional: custom domain or friendly public URL base. Leave blank to use the
# default https://<endpoint-host>/file/<bucket>/<key> form.
B2_PUBLIC_BASE_URL=

PORT=4000
